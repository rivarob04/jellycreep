# Copy to .env for plain `docker compose`, or enter these as stack variables in Dockhand.
# Generate secrets with:  openssl rand -base64 48

# --- Required ---------------------------------------------------------------
JELLYCREEP_SECRET_KEY=change-me-to-a-long-random-string
JELLYSTAT_DB_PASSWORD=change-me
JELLYSTAT_JWT_SECRET=change-me-to-a-long-random-string

# --- General ----------------------------------------------------------------
TZ=America/Toronto
JELLYCREEP_BASE_URL=https://jellycreep.example.com
JELLYCREEP_PORT=8484
JELLYCREEP_BIND=127.0.0.1          # 0.0.0.0 only if your proxy is on another host (then set TRUSTED_PROXIES to its IP)
JELLYSTAT_PORT=3000
PROXY_NETWORK=proxy                # external Docker network shared with your reverse proxy / Authentik outpost

# --- Logging in to JellyCreep -------------------------------------------------
AUTH_MODE=authentik_forward        # authentik_forward | oidc | none
TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12
ADMIN_GROUP=jellycreep-admins      # Authentik group whose members can change settings / stop streams
# For AUTH_MODE=oidc:
OIDC_ISSUER=https://auth.example.com/application/o/jellycreep
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Tracking -----------------------------------------------------------------
POLL_INTERVAL=10                   # seconds between Jellyfin session polls
MIN_WATCH_SECONDS=30               # shorter plays aren't recorded
WATCHED_PERCENT=90                 # counted as "completed" at this progress
HISTORY_RETENTION_DAYS=0           # 0 = keep forever

# --- Services (optional — you can add them in Settings instead) ---------------
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Apps behind Authentik: set <APP>_PROXY_AUTH=authentik_basic and fill the service account below.
SONARR_URL=https://sonarr.example.com
SONARR_API_KEY=
SONARR_PROXY_AUTH=authentik_basic
RADARR_URL=https://radarr.example.com
RADARR_API_KEY=
RADARR_PROXY_AUTH=authentik_basic
PROWLARR_URL=
PROWLARR_API_KEY=
PROWLARR_PROXY_AUTH=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
QBITTORRENT_PROXY_AUTH=
JELLYSEERR_URL=
JELLYSEERR_API_KEY=
JELLYSEERR_PROXY_AUTH=
JELLYSTAT_PUBLIC_URL=https://jellystat.example.com
JELLYSTAT_API_KEY=                 # create in Jellystat → Settings → API Keys after first login

AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_SERVICE_USERNAME=svc-jellycreep
AUTHENTIK_SERVICE_APP_PASSWORD=
